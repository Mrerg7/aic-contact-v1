  <!-- Exit-intent capture (CRO): email capture, once per visitor -->
  <div id="exit-popup" class="hidden fixed inset-0 z-[60] items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="exit-popup-title">
    <div class="absolute inset-0 bg-black/70" data-exit-close></div>
    <div class="relative glass rounded-3xl p-8 md:p-10 max-w-md w-full text-center border border-white/15">
      <button type="button" data-exit-close aria-label="Close offer" class="absolute top-3 right-3 w-12 h-12 inline-flex items-center justify-center rounded-xl text-white/60 hover:text-white text-xl">×</button>
      <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">BEFORE YOU GO</div>
      <h2 id="exit-popup-title" class="text-2xl font-semibold tracking-tight mb-2">Get the aic.contact buyer brief</h2>
      <p class="text-white/60 text-sm mb-6">Valuation comps, transfer checklist, and escrow steps — plus first notice if the price changes. No spam, one email.</p>
      <form id="exit-form" class="space-y-3">
        <label class="sr-only" for="exit-email">Email address</label>
        <input type="email" id="exit-email" required autocomplete="email" placeholder="you@company.com"
               class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 py-3.5 text-white placeholder:text-white/40" />
        <button type="submit" data-cta="exit-capture" class="w-full min-h-[48px] py-3.5 rounded-2xl bg-white text-[#0a0a0f] font-semibold hover:bg-white/90 transition-all">Send me the brief</button>
      </form>
      <p id="exit-success" class="hidden text-sm text-emerald-300 mt-3">Done — your email app should open with a request for the brief. We'll reply within 24 hours.</p>
      <button type="button" data-exit-close class="mt-4 min-h-[48px] px-4 text-xs text-white/40 hover:text-white/70 underline underline-offset-4">No thanks, I'm not interested in AI domains</button>
    </div>
  </div>

  <!-- Sticky mobile CTA (hidden once the inquiry form is in view) -->
  <div id="mobile-cta" class="md:hidden fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 pointer-events-none">
    <div class="mx-3 mb-3 flex items-center justify-between gap-3 rounded-2xl border border-white/15 bg-[#0a0a0f]/95 backdrop-blur-[20px] px-4 py-3 shadow-2xl pointer-events-auto">
      <div class="min-w-0">
        <div class="text-base font-semibold text-white leading-tight truncate">aic.contact</div>
        <div class="text-xs text-white/50">$4,444 &bull; Escrow protected</div>
      </div>
      <a href="#inquire" data-cta="mobile-sticky-inquire" class="shrink-0 inline-flex items-center justify-center px-5 min-h-[48px] rounded-xl bg-white text-[#0a0a0f] text-base font-semibold active:scale-[0.985] transition-all">
        Inquire Now
      </a>
    </div>
  </div>
</Layout>

<script>
  // Navbar scroll behavior
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (!navbar) return;
      if (window.scrollY > 50) {
        navbar.classList.add('border-white/[0.08]');
        navbar.style.boxShadow = '0 4px 30px rgba(0,0,0,0.3)';
      } else {
        navbar.classList.remove('border-white/[0.08]');
        navbar.style.boxShadow = 'none';
      }
    }, { passive: true });
  }

  // Smooth scroll for anchor links (same-page only; leave /path#hash to browser)
  function initSmoothScroll() {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        const href = this.getAttribute('href') || '';
        if (href.length < 2) return;
        const target = document.getElementById(href.substring(1));
        if (target) {
          e.preventDefault();
          const offset = 80;
          const bodyRect = document.body.getBoundingClientRect().top;
          const elementPosition = target.getBoundingClientRect().top;
          const offsetPosition = elementPosition - bodyRect - offset;
          window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
          target.setAttribute('tabindex', '-1');
        }
      });
    });
  }

  function trackLocal(name: string, data: Record<string, string> = {}) {
    try {
      const payload = JSON.stringify({ event: name, ...data, path: location.pathname, ts: Date.now() });
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
      }
    } catch (e) {}
  }

  // Form handling — validate, honeypot spam check, then compose pre-filled email
  function initForm() {
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('success-message');
    const errBox = document.getElementById('form-error');
    if (!form) return;

    const resetBtn = document.getElementById('reset-form-btn');
    if (resetBtn) resetBtn.addEventListener('click', resetForm);

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (errBox) { errBox.classList.add('hidden'); errBox.textContent = ''; }

      // Honeypot: bots fill it, humans don't
      const trap = (document.getElementById('company-website') as HTMLInputElement | null)?.value;
      if (trap) return;

      const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value?.trim() ?? '';
      const name = val('name');
      const email = val('email');
      if (!name || !email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (errBox) {
          errBox.textContent = 'Please add your name and a valid email so we can reply within 24 hours.';
          errBox.classList.remove('hidden');
        }
        (document.getElementById(!name ? 'name' : 'email') as HTMLElement | null)?.focus();
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (!submitBtn) return;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = 'Preparing your inquiry...';
      submitBtn.disabled = true;
      trackLocal('inquiry_submit', { offer: val('offer') || 'list' });

      const subject = `Acquisition Inquiry — aic.contact${val('offer') ? ` (Offer: $${val('offer')})` : ''}`;
      const body = [
        'Hello,',
        '',
        'I am interested in acquiring aic.contact.',
        '',
        `Name: ${name}`,
        `Email: ${email}`,
        val('org') ? `Organization / Intended use: ${val('org')}` : '',
        val('offer') ? `Offer: $${val('offer')} USD` : 'Offer: Listed price ($4,444 USD)',
        val('timeline') ? `Timeline: ${(document.getElementById('timeline') as HTMLSelectElement | null)?.selectedOptions?.[0]?.text ?? val('timeline')}` : '',
        '',
        val('message') ? `Message:\n${val('message')}` : 'Message: Please send next steps and escrow details.',
        '',
        'Best regards,',
        name,
      ]
        .filter((line) => line !== '')
        .join('\r\n');

      const mailto = `mailto:sales@desertrich.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      setTimeout(() => {
        window.location.href = mailto;
        form.style.display = 'none';
        if (successMsg) {
          successMsg.classList.remove('hidden');
          successMsg.classList.add('block');
        }
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }, 400);
    });
  }

  function resetForm() {
    const form = document.getElementById('inquiry-form');
    const successMsg = document.getElementById('success-message');
    if (successMsg) {
      successMsg.classList.add('hidden');
      successMsg.classList.remove('block');
    }
    if (form) {
      form.style.display = 'block';
      (form as HTMLFormElement).reset();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Submit Secure Inquiry';
      }
    }
  }

  // Urgency: stable pseudo-random weekly viewer count (no cookies, no fingerprinting)
  function initViewerCount() {
    const el = document.getElementById('viewer-count');
    if (!el) return;
    const week = Math.floor(Date.now() / (7 * 24 * 3600 * 1000));
    const n = 18 + (week * 37 % 29);
    el.textContent = `${n} buyers`;
  }

  // Exit-intent popup: desktop mouseleave-to-top + mobile timed fallback, once per 7 days
  function initExitIntent() {
    const popup = document.getElementById('exit-popup');
    if (!popup) return;
    let shown = false;
    try {
      const last = Number(localStorage.getItem('aic-exit-shown') || 0);
      if (Date.now() - last < 7 * 24 * 3600 * 1000) return;
    } catch (e) {}

    function show(source: string) {
      if (shown) return;
      // Don't interrupt an active inquiry
      const inquire = document.getElementById('inquire');
      if (inquire) {
        const r = inquire.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) return;
      }
      shown = true;
      try { localStorage.setItem('aic-exit-shown', String(Date.now())); } catch (e) {}
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      trackLocal('exit_popup_shown', { source });
      (document.getElementById('exit-email') as HTMLElement | null)?.focus();
    }
    function hide() {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
    }
    popup.querySelectorAll('[data-exit-close]').forEach((b) => b.addEventListener('click', hide));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });

    // Desktop: cursor leaves viewport at top
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget && (e as MouseEvent).clientY <= 0) show('mouseleave');
    });
    // Mobile / keyboard: 55s timed fallback, only if user scrolled but hasn't inquired
    setTimeout(() => {
      if (!shown && window.scrollY > 600) show('timed');
    }, 55000);

    const exitForm = document.getElementById('exit-form') as HTMLFormElement | null;
    if (exitForm) exitForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (document.getElementById('exit-email') as HTMLInputElement | null)?.value?.trim() ?? '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        (document.getElementById('exit-email') as HTMLElement | null)?.focus();
        return;
      }
      trackLocal('exit_capture', {});
      window.location.href = `mailto:sales@desertrich.com?subject=${encodeURIComponent('Buyer brief request — aic.contact')}&body=${encodeURIComponent(`Hello,\n\nPlease send the aic.contact buyer brief (valuation comps + escrow steps).\n\nEmail: ${email}\n\nBest regards,`)}`;
      const ok = document.getElementById('exit-success');
      if (ok) ok.classList.remove('hidden');
      setTimeout(hide, 2500);
    });
  }

  // Sticky mobile CTA: show after scrolling past hero, hide when inquiry form is visible
  function initMobileCta() {
    const cta = document.getElementById('mobile-cta');
    const inquire = document.getElementById('inquire');
    if (!cta) return;
    let inquireVisible = false;
    if (inquire && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          inquireVisible = entries[0]?.isIntersecting ?? false;
          update();
        },
        { threshold: 0.05 }
      ).observe(inquire);
    }
    function update() {
      const show = window.scrollY > 560 && !inquireVisible;
      cta!.classList.toggle('translate-y-full', !show);
      cta!.classList.toggle('pointer-events-none', !show);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Initialize everything
  function initializeSite() {
    initNavbar();
    initSmoothScroll();
    initForm();
    initMobileCta();
    initViewerCount();
    initExitIntent();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSite);
  } else {
    initializeSite();
  }
</script>
