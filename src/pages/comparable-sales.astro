---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_URL } from '../lib/seo';

const title = 'Short & AI Domain Comparable Sales | aic.contact';
const description =
  'Public comparable sales for short brandable and AI-relevant domains. See how 3-letter premiums trade and why aic.contact at $4,444 is positioned to move.';
const ogImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/581e6a5a-e4eb-4a01-a5d3-e85e52022d00/public';
const canonical = `${SITE_URL}/comparable-sales/`;

const comps = [
  { name: '3-letter .co brandables', range: '$5k – $25k+', note: 'Fixed supply (17,576 combos). Liquid reseller market; end-user sales skew higher.' },
  { name: 'Short .io / .ai names', range: '$3k – $50k+', note: 'Tech-vertical premium. AI relevance adds a scarcity multiplier since 2023.' },
  { name: 'Semantic new-gTLD pairs', range: '$2k – $15k', note: 'Names where the TLD completes the meaning (like ___ .contact) outperform random pairs.' },
  { name: 'aic.contact (this asset)', range: '$4,444', note: 'Below typical 3-letter ask; priced for a fast, escrow-protected end-user sale.' },
];
---

<Layout title={title} description={description} ogImage={ogImage}>
  <SEO slot="head" title={title} description={description} ogImage={ogImage} pathname="/comparable-sales/" keywords="premium domain names, domain comparable sales, investment domains, AI domains for sale, short brandable domains, buy .contact domains" />
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'ItemList',
          '@id': `${canonical}#comps`,
          name: 'Short and AI domain comparable sales',
          description: description,
          itemListElement: comps.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: `${c.name} — ${c.range}`,
            description: c.note,
          })),
        },
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
            { '@type': 'ListItem', position: 2, name: 'Comparable Sales', item: canonical },
          ],
        },
      ],
    }}
  />

  <article class="max-w-4xl mx-auto px-6 pt-32 pb-16">
    <nav aria-label="Breadcrumb" class="text-sm text-white/50 mb-6">
      <a href="/" class="hover:text-white min-h-[48px] inline-flex items-center">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span aria-current="page" class="text-white/80">Comparable Sales</span>
    </nav>

    <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">MARKET DATA · UPDATED OCT 2026</div>
    <h1 class="section-header tracking-[-0.04em] mb-4">What short, meaningful domains trade for.</h1>
    <p class="text-lg text-white/70 mb-4 max-w-2xl">Ranges below reflect widely reported public reseller and end-user bands for comparable asset classes — not guarantees. They frame why <strong class="text-white">aic.contact at $4,444</strong> is positioned for a fast sale rather than a multi-year hold.</p>
    <p class="text-xs text-white/40 mb-10 max-w-2xl">Sources: public marketplace reports (NameBio-style aggregators, Afternic/Sedo reported sales). Verify individual comps independently before underwriting.</p>

    <div class="grid md:grid-cols-2 gap-4 mb-10">
      {comps.map((c) => (
        <div class="reveal glass rounded-3xl p-8">
          <div class="text-xs tracking-[1.5px] font-medium text-white/50 mb-2">{c.range}</div>
          <h2 class="font-semibold text-xl tracking-tight mb-2">{c.name}</h2>
          <p class="text-sm text-white/60 leading-relaxed">{c.note}</p>
        </div>
      ))}
    </div>

    <div class="reveal glass rounded-3xl p-8 md:p-10 text-center">
      <h2 class="text-2xl font-semibold tracking-tight mb-2">Skip the auction. Own it outright.</h2>
      <p class="text-white/60 mb-6">One buyer, one transfer, escrow-protected. $4,444 one-time.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="mailto:sales@desertrich.com?subject=Buy%20Now%20—%20aic.contact%20($4,444)&body=Hello,%0D%0A%0D%0AI%20want%20to%20buy%20aic.contact%20now%20at%20$4,444.%20Please%20open%20escrow.%0D%0A%0D%0ABest%20regards," data-cta="comps-buy-now" class="inline-flex items-center justify-center px-8 min-h-[48px] py-3.5 rounded-2xl bg-white text-[#0a0a0f] font-semibold hover:bg-white/90 transition-all">Buy Now — $4,444</a>
        <a href="/valuation-guide/" data-cta="comps-guide" class="inline-flex items-center justify-center px-8 min-h-[48px] py-3.5 rounded-2xl border border-white/20 hover:bg-white/5 font-medium transition-all">How valuation works</a>
      </div>
      <p class="mt-5 text-sm"><a href="/" data-cta="comps-home" class="text-[#22f5ff] hover:underline">← Back to aic.contact</a></p>
    </div>
  </article>
</Layout>
